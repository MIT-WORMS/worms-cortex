# Basic service to launch a node through a manager.

string source   # Fully resolved name of the requesting node, should be set by 
                # constructing from `worms_manager.srv.LaunchNode`

# Arguments passed directly to `launch_ros.actions.Node`
string package      # Node package
string executable   # Node entry point
string name         # Node name
string[] arguments  # Additional CLI arguments
---
bool success